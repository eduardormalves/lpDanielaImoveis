<%
const icons = {
  sofa: '<path d="M4 18v-6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6"/><path d="M2 14v4h20v-4"/><path d="M6 10V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3"/>',
  chef: '<path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/>',
  bed: '<path d="M2 4v16"/><path d="M2 8h18a2 2 0 0 1 2 2v10"/><path d="M2 17h20"/><path d="M6 8v9"/>',
  building: '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/>',
  wine: '<path d="M8 22h8"/><path d="M7 10h10"/><path d="M12 15v7"/><path d="M12 15a5 5 0 0 0 5-5c0-2-.5-4-2-8H9c-1.5 4-2 6-2 8a5 5 0 0 0 5 5Z"/>',
  car: '<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/>',
  furniture: '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01M9 12v.01M9 15v.01M9 18v.01"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>'
};
const cats = [
  { key: 'todos', label: 'Todos' },
  { key: 'social', label: 'Área social' },
  { key: 'cozinha', label: 'Cozinha' },
  { key: 'suites', label: 'Suítes' },
  { key: 'banheiros', label: 'Banheiros' }
];
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= imovel.titulo %> — <%= imovel.corretora.nome %></title>
  <meta name="description" content="<%= imovel.descricao %>">
  <meta property="og:title" content="<%= imovel.titulo %>">
  <meta property="og:image" content="<%= imovel.fotos[4].src %>">
  <link rel="icon" href="<%= imovel.corretora.logoMark %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= base %>/css/style.css">
</head>
<body>

  <!-- ===== HEADER ===== -->
  <header class="header" id="header">
    <div class="container header__inner">
      <a href="#top" class="header__logo"><img src="<%= imovel.corretora.logoWhite %>" data-dark="<%= imovel.corretora.logoDark %>" data-light="<%= imovel.corretora.logoWhite %>" alt="<%= imovel.corretora.nome %>"></a>
      <nav class="header__nav">
        <a href="#sobre">O imóvel</a>
        <a href="#galeria">Galeria</a>
        <a href="#destaques">Destaques</a>
        <a href="#localizacao">Localização</a>
        <a href="<%= waLink %>" target="_blank" rel="noopener" class="header__nav-cta">Falar no WhatsApp →</a>
      </nav>
      <a href="<%= waLink %>" target="_blank" rel="noopener" class="btn btn--wa btn--sm">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2m0 18.3c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.3 8.3 0 1 1 12 20.3"/></svg>
        WhatsApp
      </a>
      <button class="header__burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
    </div>
  </header>

  <!-- ===== HERO ===== -->
  <section class="hero" id="top">
    <div class="hero__slides">
      <% [4, 1, 14].forEach((i, idx) => { %>
        <div class="hero__slide <%= idx === 0 ? 'is-active' : '' %>" style="background-image:url('<%= imovel.fotos[i].src %>')"></div>
      <% }) %>
    </div>
    <div class="hero__overlay"></div>
    <div class="container hero__content">
      <p class="hero__eyebrow reveal" data-delay="0">
        <span class="hero__dot"></span> <%= imovel.edificio %> · <%= imovel.bairro %>
      </p>
      <h1 class="hero__title reveal" data-delay="100">
        Viva o alto padrão <em>em cada detalhe</em>
      </h1>
      <p class="hero__sub reveal" data-delay="200"><%= imovel.subtitulo %>.</p>
      <div class="hero__badges reveal" data-delay="300">
        <span><b><%= imovel.area %></b> m² privativos</span>
        <span><b><%= imovel.suites %></b> suítes</span>
        <span><b><%= imovel.vagas %></b> vagas</span>
        <span><b><%= imovel.andar %></b></span>
      </div>
      <div class="hero__actions reveal" data-delay="400">
        <a href="<%= whatsapp('Olá, Daniela! Quero agendar uma visita ao apartamento ' + imovel.codigo + ' no ' + imovel.edificio + '.') %>" target="_blank" rel="noopener" class="btn btn--primary">Agendar visita</a>
        <a href="#galeria" class="btn btn--ghost">Ver fotos</a>
      </div>
      <div class="hero__price reveal" data-delay="500">
        <small>Valor</small>
        <strong><%= imovel.precoFormatado %></strong>
      </div>
    </div>
    <a href="#stats" class="hero__scroll" aria-label="Rolar"><span></span></a>
  </section>

  <!-- ===== STATS ===== -->
  <section class="stats" id="stats">
    <div class="container stats__grid">
      <div class="stat"><span class="stat__num" data-count="<%= imovel.area %>">0</span><span class="stat__unit">m²</span><p>área privativa</p></div>
      <div class="stat"><span class="stat__num" data-count="<%= imovel.suites %>">0</span><p>suítes</p></div>
      <div class="stat"><span class="stat__num" data-count="<%= imovel.banheiros %>">0</span><p>banheiros</p></div>
      <div class="stat"><span class="stat__num" data-count="<%= imovel.vagas %>">0</span><p>vagas de garagem</p></div>
    </div>
  </section>

  <!-- ===== SOBRE ===== -->
  <section class="about section" id="sobre">
    <div class="container about__grid">
      <div class="about__media reveal">
        <div class="about__img about__img--main" data-parallax="0.12"><img src="<%= imovel.fotos[3].src %>" alt="<%= imovel.fotos[3].alt %>" loading="lazy"></div>
        <div class="about__img about__img--small" data-parallax="-0.08"><img src="<%= imovel.fotos[8].src %>" alt="<%= imovel.fotos[8].alt %>" loading="lazy"></div>
      </div>
      <div class="about__text">
        <p class="section__eyebrow reveal">Sobre o imóvel</p>
        <h2 class="section__title reveal">Um apartamento pensado para <em>receber bem</em> e viver melhor</h2>
        <p class="reveal"><%= imovel.descricao %></p>
        <ul class="about__list reveal">
          <li>Living integrado à varanda gourmet com churrasqueira e adega</li>
          <li>Cozinha separada com eletrodomésticos embutidos</li>
          <li><%= imovel.suites %> suítes com marcenaria completa e ar-condicionado</li>
          <li>Entregue mobiliado e decorado</li>
        </ul>
        <a href="<%= waLink %>" target="_blank" rel="noopener" class="btn btn--primary reveal">Quero saber mais</a>
      </div>
    </div>
  </section>

  <!-- ===== GALERIA ===== -->
  <section class="gallery section section--alt" id="galeria">
    <div class="container">
      <div class="section__head">
        <div>
          <p class="section__eyebrow reveal">Galeria</p>
          <h2 class="section__title reveal">Conheça cada <em>ambiente</em></h2>
        </div>
        <div class="gallery__filters reveal" role="tablist">
          <% cats.forEach((c, i) => { %>
            <button class="gallery__filter <%= i === 0 ? 'is-active' : '' %>" data-filter="<%= c.key %>"><%= c.label %></button>
          <% }) %>
        </div>
      </div>
      <div class="gallery__grid" id="galleryGrid">
        <% imovel.fotos.forEach((f, i) => { %>
          <figure class="gallery__item reveal" data-cat="<%= f.cat %>" data-index="<%= i %>">
            <img src="<%= f.src %>" alt="<%= f.alt %>" loading="lazy">
            <figcaption><%= f.titulo %></figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ===== DESTAQUES ===== -->
  <section class="features section" id="destaques">
    <div class="container">
      <p class="section__eyebrow reveal">Destaques</p>
      <h2 class="section__title reveal">O que torna este apartamento <em>único</em></h2>
      <div class="features__grid">
        <% imovel.destaques.forEach((d) => { %>
          <article class="feature reveal">
            <div class="feature__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><%- icons[d.icone] %></svg></div>
            <h3><%= d.titulo %></h3>
            <p><%= d.texto %></p>
          </article>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ===== BANNER PARALLAX ===== -->
  <section class="banner">
    <img class="banner__img" src="<%= imovel.fotos[1].src %>" alt="" data-parallax="0.25" loading="lazy">
    <div class="banner__inner container">
      <h2 class="reveal">A vista que você <em>merece</em> acordar vendo</h2>
      <p class="reveal">Andar alto, skyline aberto e luz natural do amanhecer ao pôr do sol.</p>
    </div>
  </section>

  <!-- ===== LOCALIZAÇÃO ===== -->
  <section class="location section" id="localizacao">
    <div class="container location__grid">
      <div class="location__text">
        <p class="section__eyebrow reveal">Localização</p>
        <h2 class="section__title reveal">No endereço mais <em>desejado</em> de Londrina</h2>
        <p class="reveal"><%= imovel.endereco %> — <%= imovel.bairro %>, <%= imovel.cidade %>/<%= imovel.uf %>.</p>
        <ul class="location__list reveal">
          <li><b>Catuaí Shopping</b><span>compras, cinema e gastronomia</span></li>
          <li><b>Lago Igapó</b><span>lazer e caminhadas ao ar livre</span></li>
          <li><b>Av. Ayrton Senna</b><span>bares, restaurantes e serviços</span></li>
          <li><b>Rede hospitalar e escolas</b><span>a poucos minutos de carro</span></li>
        </ul>
      </div>
      <div class="location__map reveal">
        <iframe
          src="https://www.google.com/maps?q=<%= encodeURIComponent(imovel.endereco + ', ' + imovel.bairro + ', ' + imovel.cidade + ' - ' + imovel.uf) %>&output=embed"
          loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" title="Mapa"></iframe>
      </div>
    </div>
  </section>

  <!-- ===== CTA / FORM ===== -->
  <section class="cta section" id="contato">
    <div class="container cta__grid">
      <div class="cta__text">
        <p class="section__eyebrow reveal">Fale com a corretora</p>
        <h2 class="section__title reveal">Agende sua visita <em>hoje mesmo</em></h2>
        <p class="reveal">Preencha os dados e você será direcionado ao WhatsApp da <%= imovel.corretora.nome %> com a mensagem pronta.</p>
        <div class="cta__broker reveal">
          <img src="<%= imovel.corretora.logoMark %>" alt="">
          <div>
            <strong><%= imovel.corretora.nome %></strong>
            <span><%= imovel.corretora.creci %> · <%= imovel.corretora.telefone %></span>
          </div>
        </div>
      </div>
      <form class="cta__form reveal" id="leadForm" novalidate>
        <label>
          <span>Seu nome</span>
          <input type="text" name="nome" placeholder="Como podemos te chamar?" required>
        </label>
        <label>
          <span>Telefone</span>
          <input type="tel" name="telefone" placeholder="(43) 9 9999-9999">
        </label>
        <label>
          <span>Mensagem</span>
          <textarea name="mensagem" rows="3">Olá, Daniela! Tenho interesse no apartamento <%= imovel.codigo %> no <%= imovel.edificio %>. Gostaria de agendar uma visita.</textarea>
        </label>
        <button type="submit" class="btn btn--wa btn--full">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2m0 18.3c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.3 8.3 0 1 1 12 20.3"/></svg>
          Enviar pelo WhatsApp
        </button>
        <small>Ao enviar, você será redirecionado ao WhatsApp. Nenhum dado é armazenado.</small>
      </form>
    </div>
  </section>

  <!-- ===== FOOTER ===== -->
  <footer class="footer">
    <div class="container footer__inner">
      <img src="<%= imovel.corretora.logoDark %>" alt="<%= imovel.corretora.nome %>">
      <p><%= imovel.corretora.nome %> · <%= imovel.corretora.creci %> · <%= imovel.corretora.telefone %></p>
      <p class="footer__small">Ref. <%= imovel.codigo %> · Imagens meramente ilustrativas. Valores sujeitos a alteração sem aviso prévio.</p>
    </div>
  </footer>

  <!-- ===== FLOATING WHATSAPP ===== -->
  <a href="<%= waLink %>" target="_blank" rel="noopener" class="wa-float" aria-label="Falar no WhatsApp">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2m0 18.3c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.3 8.3 0 1 1 12 20.3"/></svg>
    <span class="wa-float__tip">Fale com a Daniela</span>
  </a>

  <!-- ===== LIGHTBOX ===== -->
  <div class="lightbox" id="lightbox" aria-hidden="true">
    <button class="lightbox__close" id="lbClose" aria-label="Fechar">&times;</button>
    <button class="lightbox__nav lightbox__nav--prev" id="lbPrev" aria-label="Anterior">&#8249;</button>
    <figure class="lightbox__figure">
      <img id="lbImg" src="" alt="">
      <figcaption><span id="lbCaption"></span><span id="lbCounter"></span></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" id="lbNext" aria-label="Próxima">&#8250;</button>
  </div>

  <script>
    window.__FOTOS__ = <%- JSON.stringify(imovel.fotos) %>;
    window.__WA__ = '<%= imovel.corretora.whatsapp %>';
  </script>
  <script src="<%= base %>/js/main.js" defer></script>
</body>
</html>
