<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Landing Pages — <%= imovel.corretora.nome %></title>
  <link rel="icon" href="<%= imovel.corretora.logoMark %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:Inter,system-ui,sans-serif;background:#0f1115;color:#e8e8ea;min-height:100vh;display:flex;flex-direction:column;align-items:center;padding:64px 24px}
    header{text-align:center;max-width:720px;margin-bottom:48px}
    header img{height:64px;margin-bottom:20px;filter:brightness(0) invert(1)}
    h1{font-size:clamp(28px,4vw,40px);font-weight:700;letter-spacing:-.02em;margin-bottom:12px}
    p{color:#9a9ca3;line-height:1.6}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;max-width:1100px;width:100%}
    .card{background:#171a21;border:1px solid #262a33;border-radius:16px;overflow:hidden;text-decoration:none;color:inherit;display:flex;flex-direction:column;transition:transform .35s cubic-bezier(.2,.8,.2,1),border-color .35s}
    .card:hover{transform:translateY(-6px);border-color:#c9a962}
    .card .thumb{aspect-ratio:16/10;overflow:hidden;position:relative}
    .card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .8s ease}
    .card:hover .thumb img{transform:scale(1.06)}
    .card .thumb span{position:absolute;top:14px;left:14px;background:rgba(15,17,21,.75);backdrop-filter:blur(6px);padding:6px 12px;border-radius:999px;font-size:12px;font-weight:600;letter-spacing:.04em;text-transform:uppercase}
    .card .body{padding:22px}
    .card h2{font-size:22px;margin-bottom:6px}
    .card .tema{color:#c9a962;font-size:13px;font-weight:600;margin-bottom:12px}
    .card p{font-size:14px}
    .card .go{margin-top:18px;display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:14px;color:#fff}
    .card .go svg{transition:transform .3s}
    .card:hover .go svg{transform:translateX(4px)}
    footer{margin-top:56px;color:#5f636d;font-size:13px;text-align:center}
  </style>
</head>
<body>
  <header>
    <img src="<%= imovel.corretora.logo %>" alt="<%= imovel.corretora.nome %>">
    <h1>3 exemplos de landing page</h1>
    <p><%= imovel.titulo %> · <%= imovel.area %> m² · <%= imovel.suites %> suítes · <%= imovel.precoFormatado %></p>
  </header>

  <div class="grid">
    <% landings.forEach((lp, i) => { %>
      <a class="card" href="/<%= lp.slug %>">
        <div class="thumb">
          <img src="<%= lp.capa %>" alt="">
          <span>Exemplo 0<%= i + 1 %></span>
        </div>
        <div class="body">
          <h2><%= lp.nome %></h2>
          <div class="tema"><%= lp.tema %></div>
          <p><%= lp.descricao %></p>
          <span class="go">Abrir landing page
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </div>
      </a>
    <% }) %>
  </div>

  <footer><%= imovel.corretora.nome %> · <%= imovel.corretora.creci %> · <%= imovel.corretora.telefone %></footer>
</body>
</html>
