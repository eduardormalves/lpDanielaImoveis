<%
const waIcon = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2m0 18.3c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.3 8.3 0 1 1 12 20.3"/></svg>';
const steps = [
  { tag: 'Chegada', titulo: 'Bem-vindo ao seu novo living', texto: 'A porta se abre para uma área social ampla, com pé-direito generoso, iluminação em sanca e o skyline da Gleba Palhano emoldurado pelas janelas.', foto: imovel.fotos[2] },
  { tag: 'Convivência', titulo: 'Jantar e estar em um único espaço', texto: 'Mesa redonda em madeira, cristaleira iluminada e o sofá logo ao lado: tudo integrado para receber família e amigos sem barreiras.', foto: imovel.fotos[3] },
  { tag: 'Varanda gourmet', titulo: 'Onde o fim de tarde acontece', texto: 'Poltronas de couro, bancada em pedra e vidros que trazem a cidade para dentro. Churrasqueira e adega climatizada ficam a um passo.', foto: imovel.fotos[1] },
  { tag: 'Gourmet', titulo: 'Churrasqueira e adega à mão', texto: 'Revestimento amadeirado, cuba em inox e armários planejados: o espaço gourmet foi desenhado para quem gosta de cozinhar acompanhado.', foto: imovel.fotos[5] },
  { tag: 'Cozinha', titulo: 'Planejada, com eletros embutidos', texto: 'Cozinha separada com forno, cooktop, coifa e geladeira French Door, porcelanato marmorizado e muita bancada de trabalho.', foto: imovel.fotos[8] },
  { tag: 'Suíte master', titulo: 'Descanso com vista', texto: 'Painel ripado, cabeceira estofada, armários espelhados e uma janela ampla para acordar vendo a cidade.', foto: imovel.fotos[11] },
  { tag: 'Suítes', titulo: 'Mais duas suítes completas', texto: 'Cada uma com marcenaria sob medida e ar-condicionado. Uma delas já está montada como home office — pronta para o trabalho remoto.', foto: imovel.fotos[15] },
  { tag: 'Banheiros', titulo: 'Mármore e texturas', texto: 'Cinco banheiros com bancadas em mármore, box de vidro e revestimentos texturizados que dão o acabamento final ao projeto.', foto: imovel.fotos[17] },
];
const faq = [
  { q: 'O apartamento é entregue mobiliado?', a: 'Sim. O imóvel é vendido completo, com móveis planejados, eletrodomésticos embutidos e itens de decoração, pronto para morar.' },
  { q: 'Quantas vagas de garagem acompanham o imóvel?', a: 'São duas vagas de garagem cobertas no subsolo do edifício.' },
  { q: 'Em que andar fica o apartamento?', a: 'É um andar alto, com vista aberta para o skyline da Gleba Palhano. O número exato é informado na visita.' },
  { q: 'Aceita financiamento bancário?', a: 'Sim. A Daniela Ribeiro Imóveis auxilia em todo o processo de aprovação de crédito junto aos principais bancos.' },
  { q: 'Como agendar uma visita?', a: 'Basta clicar em qualquer botão de WhatsApp desta página. Você fala direto com a corretora responsável, CRECI F28998.' },
];
%><!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Conheça o <%= imovel.edificio %> — <%= imovel.corretora.nome %></title>
  <meta name="description" content="<%= imovel.descricao %>">
  <meta property="og:title" content="<%= imovel.titulo %>">
  <meta property="og:image" content="<%= imovel.fotos[1].src %>">
  <link rel="icon" href="<%= imovel.corretora.logoMark %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,300&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.2.10/swiper-bundle.min.css">
  <link rel="stylesheet" href="<%= base %>/css/style.css">
</head>
<body>

  <div class="progress" id="progress"></div>

  <!-- ===== NAV ===== -->
  <nav class="nav" id="nav">
    <a href="#top" class="nav__logo"><img src="<%= imovel.corretora.logoDark %>" alt="<%= imovel.corretora.nome %>"></a>
    <div class="nav__links">
      <a href="#historia">A história</a>
      <a href="#galeria">Galeria</a>
      <a href="#simulador">Simulador</a>
      <a href="#faq">Dúvidas</a>
    </div>
    <a href="<%= waLink %>" target="_blank" rel="noopener" class="btn btn--wa btn--sm"><%- waIcon %> <span>WhatsApp</span></a>
    <button class="nav__burger" id="burger" aria-label="Abrir menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </nav>

  <!-- ===== MENU MOBILE ===== -->
  <div class="menu" id="menu" aria-hidden="true">
    <nav class="menu__links">
      <a href="#historia">A história</a>
      <a href="#galeria">Galeria</a>
      <a href="#simulador">Simulador</a>
      <a href="#faq">Dúvidas</a>
    </nav>
    <div class="menu__foot">
      <a href="<%= waLink %>" target="_blank" rel="noopener" class="btn btn--wa"><%- waIcon %> Agendar visita</a>
      <p><%= imovel.precoFormatado %> · <%= imovel.area %> m² · <%= imovel.suites %> suítes</p>
    </div>
  </div>

  <!-- ===== HERO ===== -->
  <header class="hero" id="top">
    <div class="hero__text">
      <p class="hero__eyebrow fade-up">Ref. <%= imovel.codigo %> · <%= imovel.bairro %>, <%= imovel.cidade %>/<%= imovel.uf %></p>
      <h1 class="hero__title fade-up">Um apartamento que <em>conta uma história</em> em cada ambiente</h1>
      <p class="hero__sub fade-up"><%= imovel.area %> m² privativos, <%= imovel.suites %> suítes, andar alto e entregue mobiliado. Role a página e faça o tour.</p>
      <div class="hero__cta fade-up">
        <a href="<%= whatsapp('Olá, Daniela! Quero agendar uma visita ao ' + imovel.edificio + ' (' + imovel.codigo + ').') %>" target="_blank" rel="noopener" class="btn btn--wa"><%- waIcon %> Agendar visita</a>
        <a href="#historia" class="btn btn--outline">Começar o tour ↓</a>
      </div>
      <div class="hero__price fade-up">
        <span><%= imovel.precoFormatado %></span>
        <small>ou simule o financiamento abaixo</small>
      </div>
    </div>
    <div class="hero__media">
      <div class="hero__mask"><img src="<%= imovel.fotos[4].src %>" alt="<%= imovel.fotos[4].alt %>"></div>
      <div class="hero__card">
        <div><b><%= imovel.area %></b><span>m²</span></div>
        <div><b><%= imovel.suites %></b><span>suítes</span></div>
        <div><b><%= imovel.vagas %></b><span>vagas</span></div>
      </div>
    </div>
  </header>

  <!-- ===== SCROLLYTELLING ===== -->
  <section class="story" id="historia">
    <div class="story__sticky">
      <div class="story__frame">
        <% steps.forEach((s, i) => { %>
          <img src="<%= s.foto.src %>" alt="<%= s.foto.alt %>" class="story__img <%= i === 0 ? 'is-active' : '' %>" data-step="<%= i %>" loading="<%= i === 0 ? 'eager' : 'lazy' %>">
        <% }) %>
        <div class="story__counter"><span id="storyCur">01</span> / <%= String(steps.length).padStart(2, '0') %></div>
      </div>
    </div>
    <div class="story__steps">
      <% steps.forEach((s, i) => { %>
        <article class="story__step" data-step="<%= i %>">
          <span class="story__tag"><%= s.tag %></span>
          <h2><%= s.titulo %></h2>
          <p><%= s.texto %></p>
          <img src="<%= s.foto.src %>" alt="<%= s.foto.alt %>" class="story__mobile-img" loading="lazy">
        </article>
      <% }) %>
    </div>
  </section>

  <!-- ===== DESTAQUES ===== -->
  <section class="highlights">
    <div class="wrap">
      <p class="eyebrow fade-up">Por que este apartamento</p>
      <h2 class="title fade-up">Tudo o que você procura, <em>em um só endereço</em></h2>
      <div class="highlights__grid">
        <% imovel.destaques.forEach((d, i) => { %>
          <div class="hl fade-up" style="--i:<%= i %>">
            <span class="hl__num"><%= String(i + 1).padStart(2, '0') %></span>
            <h3><%= d.titulo %></h3>
            <p><%= d.texto %></p>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ===== GALERIA (SWIPER) ===== -->
  <section class="gallery" id="galeria">
    <div class="wrap gallery__head">
      <div>
        <p class="eyebrow fade-up">Galeria completa</p>
        <h2 class="title fade-up"><%= imovel.fotos.length %> fotos do imóvel</h2>
      </div>
      <div class="gallery__nav fade-up">
        <button class="gallery__btn" id="gPrev" aria-label="Anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 12H5M11 6l-6 6 6 6"/></svg></button>
        <button class="gallery__btn" id="gNext" aria-label="Próxima"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
      </div>
    </div>
    <div class="swiper gallery__swiper">
      <div class="swiper-wrapper">
        <% imovel.fotos.forEach((f) => { %>
          <div class="swiper-slide">
            <figure><img src="<%= f.src %>" alt="<%= f.alt %>" loading="lazy"><figcaption><%= f.titulo %></figcaption></figure>
          </div>
        <% }) %>
      </div>
      <div class="swiper-pagination"></div>
    </div>
  </section>

  <!-- ===== SIMULADOR ===== -->
  <section class="sim" id="simulador">
    <div class="wrap sim__grid">
      <div class="sim__text">
        <p class="eyebrow fade-up">Simulador</p>
        <h2 class="title fade-up">Quanto ficaria <em>por mês</em>?</h2>
        <p class="fade-up">Ajuste a entrada e o prazo para ter uma estimativa. Os valores são aproximados (Tabela Price) e não substituem a simulação do banco.</p>
        <a href="<%= whatsapp('Olá, Daniela! Fiz uma simulação na página do ' + imovel.edificio + ' (' + imovel.codigo + ') e quero conversar sobre financiamento.') %>" target="_blank" rel="noopener" class="btn btn--wa fade-up"><%- waIcon %> Falar sobre financiamento</a>
      </div>
      <div class="sim__card fade-up">
        <div class="sim__row">
          <div class="sim__label"><span>Valor do imóvel</span><b><%= imovel.precoFormatado %></b></div>
        </div>
        <div class="sim__row">
          <div class="sim__label"><span>Entrada</span><b id="simEntradaTxt">—</b></div>
          <input type="range" id="simEntrada" min="20" max="80" step="5" value="30">
          <div class="sim__hint"><span>20%</span><span id="simEntradaPct">30%</span><span>80%</span></div>
        </div>
        <div class="sim__row">
          <div class="sim__label"><span>Prazo</span><b id="simPrazoTxt">—</b></div>
          <input type="range" id="simPrazo" min="60" max="420" step="12" value="360">
          <div class="sim__hint"><span>5 anos</span><span>35 anos</span></div>
        </div>
        <div class="sim__row">
          <div class="sim__label"><span>Taxa de juros (a.a.)</span><b id="simTaxaTxt">—</b></div>
          <input type="range" id="simTaxa" min="8" max="14" step="0.25" value="10.5">
        </div>
        <div class="sim__result">
          <span>Parcela estimada</span>
          <strong id="simParcela">R$ 0</strong>
          <small>Financiando <b id="simFinanciado">R$ 0</b></small>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== LOCALIZAÇÃO ===== -->
  <section class="local">
    <div class="wrap local__grid">
      <div class="local__map fade-up">
        <iframe src="https://www.google.com/maps?q=<%= encodeURIComponent(imovel.endereco + ', ' + imovel.bairro + ', ' + imovel.cidade + ' - ' + imovel.uf) %>&output=embed" loading="lazy" title="Mapa" allowfullscreen></iframe>
      </div>
      <div class="local__text">
        <p class="eyebrow fade-up">Localização</p>
        <h2 class="title fade-up"><%= imovel.bairro %></h2>
        <p class="fade-up"><%= imovel.endereco %>, <%= imovel.cidade %>/<%= imovel.uf %>. O bairro mais valorizado da cidade, com infraestrutura completa a poucos minutos.</p>
        <div class="local__pois">
          <div class="poi fade-up"><b>5 min</b><span>Catuaí Shopping</span></div>
          <div class="poi fade-up"><b>7 min</b><span>Lago Igapó</span></div>
          <div class="poi fade-up"><b>3 min</b><span>Av. Ayrton Senna</span></div>
          <div class="poi fade-up"><b>10 min</b><span>Centro</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="faq" id="faq">
    <div class="wrap wrap--narrow">
      <p class="eyebrow fade-up">Dúvidas frequentes</p>
      <h2 class="title fade-up">Perguntas que <em>sempre</em> recebemos</h2>
      <div class="faq__list">
        <% faq.forEach((f) => { %>
          <details class="faq__item fade-up">
            <summary><%= f.q %><i></i></summary>
            <div class="faq__body"><p><%= f.a %></p></div>
          </details>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- ===== CTA FINAL ===== -->
  <section class="final">
    <div class="wrap final__box fade-up">
      <img src="<%= imovel.corretora.logoMark %>" alt="" class="final__avatar">
      <h2 class="title">Vamos marcar a sua <em>visita</em>?</h2>
      <p>Fale direto com a Daniela pelo WhatsApp. Sem formulário, sem espera.</p>
      <a href="<%= whatsapp('Olá, Daniela! Quero agendar uma visita ao ' + imovel.edificio + ' (' + imovel.codigo + ').') %>" target="_blank" rel="noopener" class="btn btn--wa btn--lg"><%- waIcon %> Chamar no WhatsApp</a>
      <small><%= imovel.corretora.nome %> · <%= imovel.corretora.creci %> · <%= imovel.corretora.telefone %></small>
    </div>
  </section>

  <footer class="footer">
    <img src="<%= imovel.corretora.logoDark %>" alt="<%= imovel.corretora.nome %>">
    <p>Ref. <%= imovel.codigo %> · Imagens meramente ilustrativas · Valores sujeitos a alteração sem aviso prévio.</p>
  </footer>

  <!-- ===== BOTÃO FLUTUANTE ===== -->
  <a href="<%= waLink %>" target="_blank" rel="noopener" class="wa-float" aria-label="WhatsApp"><%- waIcon %></a>

  <script>window.__PRECO__ = <%= imovel.preco %>;</script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.2.10/swiper-bundle.min.js"></script>
  <script src="<%= base %>/js/main.js" defer></script>
</body>
</html>
